#!/usr/bin/env bash
set -euo pipefail

# Heavy `go test` fan-out runs here, at push time, instead of on every commit
# (#3628). pre-commit previously invoked `make test-fast-parallel` on every
# commit. Its outer shard fan-out can compile ~2.8 GiB test binaries per job,
# so the canonical runner now derives concurrency from both CPU and available
# memory while preserving an explicit LOCAL_TEST_JOBS override. Running the
# suite at push time also fires it only when Go sources actually change.
#
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref
# on stdin (see githooks(5)).

zero="0000000000000000000000000000000000000000"

# Upstream-contribution guard (gascity FORK FORMULA, Kaushik 2026-08-13):
# gascity is developed in our fork material-lab-io/gascity; we PR to the
# gastownhall UPSTREAM only when a change is PROVEN in the fork. This blocks
# pushes to the upstream network unless GC_ALLOW_UPSTREAM_PUSH=1. git passes
# the remote name as $1 and the remote URL as $2 to a pre-push hook. Runs once
# per invocation, independent of stdin refs, before any other work.
upg="$(git rev-parse --show-toplevel)/scripts/upstream-push-guard.sh"
if [ -f "$upg" ]; then
  # shellcheck source=scripts/upstream-push-guard.sh disable=SC1091
  . "$upg"
  assert_not_unproven_upstream_push "${2:-}" || exit 1
fi

# Tag-only-push skip (gcf-9kd1): a tag ref is always a brand-new remote ref
# (remote_sha == zero), so the "new remote branch: run the suite" rule below
# used to fire on every tag push even when the tagged commit is byte-identical
# to code already verified on the remote's default branch — v1.3.11 sat 44
# minutes re-running the suite on a loaded host for exactly this reason. Skip
# ONLY when the local ref is under refs/tags/ AND the commit it points at is
# already an ancestor of the remote's default branch. A tag pointing at a
# commit NOT yet on the remote (a real code push wearing a tag) still runs it,
# and this check is remote-name-aware so it does not trust a stale local
# remote-tracking ref for a different remote.
remote_name="${1:-origin}"
tag_already_verified() {
  local local_sha="$1"
  local commit remote_default
  commit="$(git rev-parse "${local_sha}^{commit}" 2>/dev/null)" || return 1
  remote_default="$(git symbolic-ref -q --short "refs/remotes/${remote_name}/HEAD" 2>/dev/null)"
  remote_default="${remote_default:-${remote_name}/main}"
  git rev-parse --verify -q "$remote_default" >/dev/null 2>&1 || return 1
  git merge-base --is-ancestor "$commit" "$remote_default" 2>/dev/null
}

go_changed=0
any_non_deletion=0
while read -r local_ref local_sha _remote_ref remote_sha; do
  # Branch deletion — nothing to test, nothing to guard.
  if [ "$local_sha" = "$zero" ]; then
    continue
  fi
  any_non_deletion=1
  case "$local_ref" in
    refs/tags/*)
      if tag_already_verified "$local_sha"; then
        echo "pre-push: $local_ref points at a commit already verified on ${remote_name}'s default branch — skipping fast suite for this ref" >&2
        continue
      fi
      go_changed=1
      continue
      ;;
  esac
  # New remote branch: no cheap base to diff against — run the suite.
  if [ "$remote_sha" = "$zero" ]; then
    go_changed=1
    continue
  fi
  if git diff --name-only "$remote_sha" "$local_sha" -- '*.go' 2>/dev/null | grep -q .; then
    go_changed=1
  fi
done

# Bead ownership/staleness guard (ga-fip9ps.1): re-checks bd claim state
# immediately before this push leaves the machine, once per invocation
# (not per ref) regardless of whether Go sources changed. A mayor ruling
# (reassign/close/hold/reroute) that landed after this push was queued
# must not be allowed to clobber a branch another agent has since taken
# over. Bypass: `git push --no-verify`.
if [ "$any_non_deletion" -eq 1 ]; then
  repo_root="$(git rev-parse --show-toplevel)"
  # shellcheck source=../scripts/push-ownership-guard.sh disable=SC1091
  . "$repo_root/scripts/push-ownership-guard.sh"
  if ! assert_bead_still_claimed; then
    exit 1
  fi
fi

if [ "$go_changed" -eq 0 ]; then
  exit 0
fi

# The Makefile and direct sharded runner share scripts/test-local-job-count as
# their default policy. Do not shadow it here; an explicit override still wins.
exec make test-fast-parallel
