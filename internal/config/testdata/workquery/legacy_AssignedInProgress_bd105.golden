sh -c 'for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; legacy=""; case "$id" in *control-dispatcher) legacy="${id%control-dispatcher}workflow-control";; esac; for cand in "$id" "$legacy"; do [ -z "$cand" ] && continue; tmo=""; if command -v timeout >/dev/null 2>&1; then tmo="timeout -k 2 10"; elif [ -z "$gc_tmo_warned" ]; then gc_tmo_warned=1; echo "gc: timeout(1) not found, running bd list unbounded" >&2; fi; r=$($tmo bd list --status in_progress --assignee="$cand" --json --limit=1 2>/dev/null); rc=$?; if [ "$rc" = 124 ] || [ "$rc" = 137 ]; then echo "gc: bd list timed out after 10s for $cand, in-progress state UNKNOWN" >&2; exit "$rc"; fi; if [ -n "$r" ] && [ "$r" != "[]" ]; then bid=$(printf "%s" "$r" | jq -r ".[0].id // empty" 2>/dev/null); bb="[]"; [ -n "$bid" ] && bb=$(bd show "$bid" --json 2>/dev/null | jq -c '\''[.[0].dependencies[]? | select(.dependency_type == "blocks" or .dependency_type == "waits-for" or .dependency_type == "conditional-blocks") | {id, status}]'\'' 2>/dev/null); [ -z "$bb" ] && bb="[]"; nblocked=$(printf "%s" "$bb" | jq -r '\''[.[] | select(((.status // "") | ascii_downcase) != "closed")] | length'\'' 2>/dev/null); [ -z "$nblocked" ] && nblocked=0; nheld=$(printf "%s" "$r" | jq -r '\''[ (.[0].labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length'\'' 2>/dev/null); [ -z "$nheld" ] && nheld=0; if [ "$nblocked" = "0" ] && [ "$nheld" = "0" ]; then r_enriched=$(printf "%s" "$r" | jq -c --argjson bb "$bb" '\''map(. + {blocked_by: $bb})'\'' 2>/dev/null); [ -n "$r_enriched" ] && [ "$r_enriched" != "[]" ] && r="$r_enriched"; printf "%s" "$r" && exit 0; fi; fi; r=$(bd query --json '\''ephemeral=true AND status=in_progress AND assignee='\''"$cand" --limit=20 2>/dev/null | jq --arg id "$cand" '\''[.[] | select((.assignee // "") == $id) | select(([ (.labels // [])[] | select(. == "hold:mayor" or . == "hold:external") ] | length) == 0)] | .[:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; done; done; printf "[]"'